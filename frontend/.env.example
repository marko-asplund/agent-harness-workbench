# Agent Server (fixed destination for authenticated requests)
NEXT_PUBLIC_API_URL=http://localhost:2024
NEXT_PUBLIC_ASSISTANT_ID=deep_agent

# For a frontend tunnel, use https://YOUR_HOST/agent-api above, and set its hostname:
ALLOWED_DEV_ORIGINS=

# Supabase project URL and publishable key (safe for browser use)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
